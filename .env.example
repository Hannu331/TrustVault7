# Generate a unique random value of at least 32 bytes for production.
TRUSTVAULT_SECRET_KEY=replace-with-a-long-random-secret

# The first administrator is created on first startup when these are set.
TRUSTVAULT_ADMIN_USERNAME=admin
TRUSTVAULT_ADMIN_PASSWORD=change-this-in-your-local-env
TRUSTVAULT_ADMIN_NAME=TrustVault Administrator

# Set true only when serving behind HTTPS.
TRUSTVAULT_HTTPS_ONLY=false
